{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hermes-chan",
  "version": "0.1.0",
  "identifier": "com.alleybo55.hermeschan",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hermeschan",
        "title": "hermeschan",
        "width": 260,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "effect",
        "title": "hermes-chan effect",
        "url": "effect.html",
        "width": 1,
        "height": 1,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
